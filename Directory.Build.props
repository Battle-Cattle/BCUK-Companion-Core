<Project>
  <!--
    Every type and member needs an XML doc comment, including internal and private ones (CLAUDE.md,
    "Docstrings"). StyleCop's documentation rules enforce that at build time; .editorconfig turns them
    into errors and switches off the rest of StyleCop, and stylecop.json extends them to non-public members.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- SA1600 reports the same missing docs, for every accessibility rather than only public ones. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- A <param> or <see cref> that no longer matches the code, or is ambiguous, is a stale doc comment. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0419;CS1572;CS1573;CS1574;CS1580;CS1584;CS1734</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The Shell, its tests and the Sample target net10.0-windows. This lets them restore and build on
      Linux and macOS too (fetching the Windows reference packs from NuGet), which GitHub's automatic
      dependency submission and the Linux build in CLAUDE.md both need. They still only run on Windows.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>
</Project>
